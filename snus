local function findClosestTargetOre()
    if not isScriptRunning or not Players.LocalPlayer.Character then return nil end
    local playerHrp = Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not playerHrp then return nil end

    local playerPos = playerHrp.Position
    local closestOre = nil
    local minDistance = ESPConfig.DigAuraRadius + 1

    local partsInRadius = Workspace:GetPartBoundsInRadius(playerPos, ESPConfig.DigAuraRadius)

    for _, part in ipairs(partsInRadius) do
        if part and part.Parent and part:IsA("BasePart") then
            local oreType = part:GetAttribute("MineId")
            local isTargetType = false

            if oreType and type(oreType) == "string" and oreType ~= "CargoVol" and oreType ~= "nophr" then
                if ESPConfig.DigAuraTargetOres[oreType] == true then
                    isTargetType = true
                end
            else
                 for attrName, attrValue in pairs(part:GetAttributes()) do
                     if attrValue == true and ESPConfig.DigAuraTargetOres[attrName] == true then
                         isTargetType = true
                         oreType = attrName
                         break
                     end
                 end
            end

            if isTargetType then
                local distance = (playerPos - part.Position).Magnitude
                if distance <= ESPConfig.DigAuraRadius and distance < minDistance then
                     minDistance = distance
                     closestOre = part
                end
            end
        end
    end

    return closestOre
end

local function runDigAuraLoop()
    if not isScriptRunning or not digAuraActive then
        print("DigAura остановлена.")
        return
    end

    local oreToDig = findClosestTargetOre()

    if oreToDig then
        local currentTime = tick()
        if currentTime - lastDigTime >= ESPConfig.DigAuraCooldown then
            local mineEvent = findMineRemote()
            if mineEvent then
                local orePos = oreToDig.Position
                local oreTypeAttr = oreToDig:GetAttribute("MineId")
                local oreType = "Unknown"
                if oreTypeAttr and type(oreTypeAttr) == "string" then
                    oreType = oreTypeAttr
                else
                     for attrName, attrValue in pairs(oreToDig:GetAttributes()) do
                          if attrValue == true and ESPConfig.DigAuraTargetOres[attrName] == true then
                               oreType = attrName
                               break
                          end
                     end
                end

                -- ЗАМЕНЯЕМ ПЕРВЫЙ АРГУМЕНТ С 24 НА 252:
                local args = {
                    [1] = 59,
                    [2] = orePos
                }
                -- КОНЕЦ ИЗМЕНЕНИЯ

                local success, err = pcall(function()
                    mineEvent:FireServer(unpack(args))
                end)
                if success then
                     print("DigAura: Копаем", (translations[oreType] or oreType), "в", orePos)
                     lastDigTime = currentTime
                     local esp = oreToDig:FindFirstChild("OreESP")
                     if esp then task.delay(0.1, function() if esp then esp:Destroy() end end) end
                else
                    warn("DigAura: Ошибка FireServer:", err)
                end
            else
                 warn("DigAura: RemoteEvent для добычи не найден, остановка.")
                 digAuraActive = false
                 updateStatusIndicators()
                 if digAuraLoopConnection then digAuraLoopConnection:Disconnect(); digAuraLoopConnection = nil; end
                 return
            end
        end
    end

    digAuraLoopConnection = RunService.Heartbeat:Once(runDigAuraLoop)
end


local function startDigAura()
    if digAuraActive or not isScriptRunning then return end
    local mineEvent = findMineRemote()
    if not mineEvent then
        warn("Невозможно запустить DigAura: RemoteEvent не найден.")
        return
    end
    digAuraActive = true
    lastDigTime = 0
    print("DigAura запущена. Радиус:", ESPConfig.DigAuraRadius, "Кулдаун:", ESPConfig.DigAuraCooldown)
    updateStatusIndicators()
    if digAuraLoopConnection then digAuraLoopConnection:Disconnect(); digAuraLoopConnection = nil; end
    task.spawn(runDigAuraLoop)
end

local function stopDigAura()
    if not digAuraActive then return end
    digAuraActive = false
    if digAuraLoopConnection then
        digAuraLoopConnection:Disconnect()
        digAuraLoopConnection = nil
    end
    print("DigAura остановлена.")
    updateStatusIndicators()
end

