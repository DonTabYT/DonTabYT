local function CreateDrone()
    if spawnedDrone and spawnedDrone.Parent then
        CreateNotification("⚠️ Дрон уже существует! Сначала удалите текущий.", 3)
        return
    end
    
    print("Создаём дрон типа: " .. droneType)
    local creationSuccess = Network:WaitForChild("CreateDrone"):InvokeServer(droneType)
    print("Результат создания дрона:", creationSuccess)
    
    -- Пауза для появления дрона в игровом мире
    task.wait(2)
    
    -- Сохраняем ссылку на созданный дрон
    local droneFolder = workspace:FindFirstChild("Drones")
    if droneFolder then
        local drones = droneFolder:GetChildren()
        if #drones > 0 then
            -- Важное исправление: берем последний созданный дрон и проверяем его владельца
            for i = #drones, 1, -1 do
                local potentialDrone = drones[i]
                -- Проверяем, принадлежит ли этот дрон локальному игроку
                local isDroneOwnedByLocalPlayer = false
                
                -- Проверка на tag или другой атрибут владельца
                if potentialDrone:FindFirstChild("Owner") and potentialDrone.Owner.Value == LocalPlayer then
                    isDroneOwnedByLocalPlayer = true
                end
                
                -- Если владельца нет, проверяем, создан ли этот дрон недавно
                if not isDroneOwnedByLocalPlayer then
                    -- Проверяем время создания (если доступно)
                    if potentialDrone:GetAttribute("CreationTime") then
                        local creationTime = potentialDrone:GetAttribute("CreationTime")
                        if tick() - creationTime < 10 then -- Если создан менее 10 секунд назад
                            isDroneOwnedByLocalPlayer = true
                        end
                    else
                        -- Если нет атрибута времени создания, предполагаем, что последний созданный - наш
                        if i == #drones then
                            isDroneOwnedByLocalPlayer = true
                        end
                    end
                end
                
                if isDroneOwnedByLocalPlayer then
                    spawnedDrone = potentialDrone
                    break
                end
            end
        end
    end
    
    if not spawnedDrone then
        warn("❌ Дрон не был найден в игровом мире")
        CreateNotification("❌ Дрон не был найден в игровом мире", 3)
        return false
    end
    
    -- Маркируем наш дрон для последующей идентификации
    spawnedDrone:SetAttribute("OwnedByLocalScript", true)
    spawnedDrone:SetAttribute("CreationTime", tick())
    
    -- Добавляем ESP на дрон
    local espTag = CreateESP(spawnedDrone, "ДРОН | " .. droneType, Color3.fromRGB(0, 255, 0))
    print("✅ ESP добавлен на дрон")
    
    -- Убедимся, что у дрона есть PrimaryPart для телепортации
    local primaryPart = spawnedDrone.PrimaryPart
    if not primaryPart then
        -- Если PrimaryPart не установлен, найдём любую часть для установки
        for _, part in pairs(spawnedDrone:GetDescendants()) do
            if part:IsA("BasePart") then
                spawnedDrone.PrimaryPart = part
                primaryPart = part
                print("✅ Установлен PrimaryPart для дрона:", part.Name)
                break
            end
        end
    end
    
    if not primaryPart then
        warn("❌ Не удалось найти часть для установки PrimaryPart на дроне.")
        CreateNotification("❌ Не удалось найти PrimaryPart для дрона", 3)
        return false
    end
    
    -- Функция для постоянного обновления положения ESP
    local function UpdateESP()
        if espTag and espTag.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and primaryPart then
            local distance = (LocalPlayer.Character.HumanoidRootPart.Position - primaryPart.Position).Magnitude
            espTag.TextLabel.Text = string.format("ДРОН | %s\n%.1f м", droneType, distance)
        end
    end
    
    -- Обновление ESP каждый кадр
