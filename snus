-- Функция для создания ESP
local function CreateESP(object, text, color)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.Adornee = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart")
    
    local textLabel = Instance.new("TextLabel")
    textLabel.BackgroundTransparency = 1
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.Text = text or "Дрон"
    textLabel.TextColor3 = color or Color3.fromRGB(255, 0, 0)
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = billboard
    
    -- Создаём обводку вокруг объекта
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color or Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = object
    highlight.Parent = object
    
    billboard.Parent = object
    
    return billboard
end

-- Создаем уведомление
local function CreateNotification(text, duration)
    duration = duration or 3
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "Notification"
    screenGui.ResetOnSpawn = false
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 50)
    frame.Position = UDim2.new(0.5, -150, 0.8, 0)
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = screenGui
    
    local cornerRadius = Instance.new("UICorner")
    cornerRadius.CornerRadius = UDim.new(0, 10)
    cornerRadius.Parent = frame
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -20, 1, 0)
    textLabel.Position = UDim2.new(0, 10, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 18
    textLabel.TextWrapped = true
    textLabel.Parent = frame
    
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    -- Анимация появления
    frame.Position = UDim2.new(0.5, -150, 1.1, 0)
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    game:GetService("TweenService"):Create(frame, tweenInfo, {Position = UDim2.new(0.5, -150, 0.8, 0)}):Play()
    
    -- Автоматическое удаление
    task.spawn(function()
        task.wait(duration)
        tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        local tween = game:GetService("TweenService"):Create(frame, tweenInfo, {Position = UDim2.new(0.5, -150, 1.1, 0)})
        tween.Completed:Connect(function()
            screenGui:Destroy()
        end)
        tween:Play()
    end)
    
    return screenGui
end

-- Функция для поиска дрона в мире
local function FindDrone()
    -- Поиск дрона в папке Workspace.Drones
    local foundDrone = nil
    if workspace:FindFirstChild("Drones") then
        print("✅ Найдена папка Drones в Workspace")
        
        -- Получаем недавно созданные дроны (последние в списке)
        local droneFolder = workspace.Drones
        local drones = droneFolder:GetChildren()
        
        if #drones > 0 then
            -- Берём последний добавленный дрон
            foundDrone = drones[#drones]
            print("✅ Найден дрон:", foundDrone.Name)
            
            -- Проверяем, что это действительно дрон нужного типа
            local isCorrectDroneType = false
            
            -- Проверяем по имени или дочерним компонентам
            if foundDrone:FindFirstChild("EV") then
                isCorrectDroneType = true
            end
            
            for _, part in ipairs(foundDrone:GetDescendants()) do
                if part.Name == droneType or part.Name:match("Battery") then
                    isCorrectDroneType = true
                    break
                end
            end
            
            if not isCorrectDroneType then
                warn("⚠️ Найденный дрон может не соответствовать типу " .. droneType)
            end
        else
            warn("❌ В папке Drones не найдено ни одного дрона")
        end
    else
        warn("❌ Папка Drones не найдена в Workspace")
    end
    
    -- Если дрон не найден в Drones, ищем по всему Workspace
    if not foundDrone then
        print("Ищем дрон по всему Workspace...")
        local recentModels = {}
        
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= workspace.Terrain then
                -- Проверяем, содержит ли модель часть Battery или EV
                local hasBattery = false
                for _, part in ipairs(obj:GetDescendants()) do
                    if part.Name:match("Battery") or part.Name == "EV" then
                        hasBattery = true
                        break
                    end
                end
                
                if hasBattery then
                    table.insert(recentModels, obj)
                end
            end
        end
        
        if #recentModels > 0 then
            foundDrone = recentModels[#recentModels]
            print("✅ Найден вероятный дрон:", foundDrone.Name)
        end
    end
    
    return foundDrone
end

-- Функция для создания дрона
local function CreateDrone()
    if spawnedDrone and spawnedDrone.Parent then
        CreateNotification("⚠️ Дрон уже существует! Сначала удалите текущий.", 3)
        return
    end
    
    print("Создаём дрон типа: " .. droneType)
    local creationSuccess = Network:WaitForChild("CreateDrone"):InvokeServer(droneType)
    print("Результат создания дрона:", creationSuccess)
    
    -- Пауза для появления дрона в игровом мире
    task.wait(2)
    
    -- Поиск дрона
    spawnedDrone = FindDrone()
    
    if not spawnedDrone then
        warn("❌ Дрон не был найден в игровом мире")
        CreateNotification("❌ Дрон не был найден в игровом мире", 3)
        return false
    end
    
    -- Добавляем ESP на дрон
    local espTag = CreateESP(spawnedDrone, "ДРОН | " .. droneType, Color3.fromRGB(0, 255, 0))
    print("✅ ESP добавлен на дрон")
    
    -- Убедимся, что у дрона есть PrimaryPart для телепортации
    local primaryPart = spawnedDrone.PrimaryPart
    if not primaryPart then
        -- Если PrimaryPart не установлен, найдём любую часть для установки
        for _, part in pairs(spawnedDrone:GetDescendants()) do
            if part:IsA("BasePart") then
                spawnedDrone.PrimaryPart = part
                primaryPart = part
                print("✅ Установлен PrimaryPart для дрона:", part.Name)
                break
            end
        end
    end
    
    if not primaryPart then
        warn("❌ Не удалось найти часть для установки PrimaryPart на дроне.")
        CreateNotification("❌ Не удалось найти PrimaryPart для дрона", 3)
        return false
    end
    
    -- Функция для постоянного обновления положения ESP
    local function UpdateESP()
        if espTag and espTag.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and primaryPart then
            local distance = (LocalPlayer.Character.HumanoidRootPart.Position - primaryPart.Position).Magnitude
            espTag.TextLabel.Text = string.format("ДРОН | %s\n%.1f м", droneType, distance)
        end
    end
    
    -- Обновление ESP каждый кадр
    if espConnection then
        espConnection:Disconnect()
    end
    espConnection = RunService.RenderStepped:Connect(UpdateESP)
    
    -- Очистка при удалении дрона
    spawnedDrone.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            if espConnection then
                espConnection:Disconnect()
                espConnection = nil
            end
            spawnedDrone = nil
            print("❌ Дрон был удалён")
            CreateNotification("❌ Дрон был удалён", 3)
        end
    end)
    
    -- Для отладки сохраняем дрон в глобальную переменную
    _G.lastSpawnedDrone = spawnedDrone
    print("Дрон сохранён в _G.lastSpawnedDrone для отладки")
    
    CreateNotification("✅ Дрон создан! Используйте интерфейс для управления.", 3)
    return true
end

-- Функция для телепортации дрона к игроку
local function TeleportDroneToPlayer()
    if not (spawnedDrone and spawnedDrone.Parent) then
        CreateNotification("❌ Сначала создайте дрон!", 3)
        return
    end
    
    -- Получаем целевого игрока
    local targetPlayer = Players:FindFirstChild(targetPlayerName)
    if not (targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")) then
        warn("❌ Не удалось найти игрока или его позицию.")
        CreateNotification("❌ Игрок не найден: " .. targetPlayerName, 3)
        return
    end
    
    -- Определяем первичную часть дрона
    local primaryPart = spawnedDrone.PrimaryPart
    if not primaryPart then
        for _, part in pairs(spawnedDrone:GetDescendants()) do
            if part:IsA("BasePart") then
                spawnedDrone.PrimaryPart = part
                primaryPart = part
                break
            end
        end
    end
    
    if not primaryPart then
        CreateNotification("❌ Не найден PrimaryPart дрона", 3)
        return
    end
    
    -- Телепортация дрона к игроку
    local targetPos = targetPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 5, 0)
    print("Телепортируем дрон к игроку:", targetPlayerName, "на позицию:", tostring(targetPos))
    
    -- Пробуем все возможные методы телепортации
    print("Метод 1: SetPrimaryPartCFrame")
    pcall(function()
        spawnedDrone:SetPrimaryPartCFrame(CFrame.new(targetPos))
    end)
    
    print("Метод 2: Перемещение через свойство CFrame")
    pcall(function()
        for _, part in pairs(spawnedDrone:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CFrame = CFrame.new(targetPos)
            end
        end
    end)
    
    print("Метод 3: Сетевые события")
    -- Пытаемся найти и использовать событие для управления дроном
    local possibleEvents = {
        "MoveDrone", 
        "TeleportDrone", 
        "SetDronePosition", 
        "UpdateDronePosition",
        "Drive"
    }
    
    for _, eventName in ipairs(possibleEvents) do
        local event = Network:FindFirstChild(eventName)
        if event then
            print("Пробуем событие:", eventName)
            pcall(function()
                if event:IsA("RemoteEvent") then
                    event:FireServer(spawnedDrone, CFrame.new(targetPos))
                elseif event:IsA("RemoteFunction") then
                    event:InvokeServer(spawnedDrone, CFrame.new(targetPos))
                end
            end)
        end
    end
    
    CreateNotification("✅ Дрон телепортирован к " .. targetPlayerName, 3)
    print("✅ Все методы телепортации испробованы")
end

-- Функция для взрыва дрона
local function ExplodeDrone()
    if not (spawnedDrone and spawnedDrone.Parent) then
        CreateNotification("❌ Сначала создайте дрон!", 3)
        return
    end
    
    local explodeEvent = Network:FindFirstChild("ExplodeDrone")
    if explodeEvent then
        print("💥 Активируем взрыв дрона")
        
        -- Создаем визуальный эффект до взрыва
        local primaryPart = spawnedDrone.PrimaryPart
        if primaryPart then
            -- Создаем эффект мигания перед взрывом
            for i = 1, 3 do
                if not spawnedDrone or not spawnedDrone.Parent then
                    break
                end
                
                for _, part in pairs(spawnedDrone:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Color = Color3.fromRGB(255, 0, 0)
                    end
                end
                task.wait(0.1)
                
                if not spawnedDrone or not spawnedDrone.Parent then
                    break
                end
                
                for _, part in pairs(spawnedDrone:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Color = Color3.fromRGB(255, 255, 0)
                    end
                end
                task.wait(0.1)
            end
        end
        
        -- Запускаем взрыв
        local success, errorMsg = pcall(function()
            explodeEvent:FireServer(spawnedDrone)
        end)
        
        if success then
            CreateNotification("💥 Дрон взорван!", 3)
            if espConnection then
                espConnection:Disconnect()
                espConnection = nil
            end
            spawnedDrone = nil
        else
            warn("❌ Ошибка при взрыве дрона:", errorMsg)
            CreateNotification("❌ Ошибка при взрыве дрона", 3)
        end
    else
        -- Пробуем альтернативные имена событий
        local alternativeEvents = {"DetonateDrone", "DestoryDrone", "DestroyDrone"}
        local eventFound = false
        
        for _, eventName in ipairs(alternativeEvents) do
            local event = Network:FindFirstChild(eventName)
            if event then
                eventFound = true
                local success, errorMsg = pcall(function()
                    event:FireServer(spawnedDrone)
                end)
                
                if success then
                    CreateNotification("💥 Дрон взорван!", 3)
                    if espConnection then
                        espConnection:Disconnect()
                        espConnection = nil
                    end
                    spawnedDrone = nil
                    break
                end
            end
        end
        
        if not eventFound then
            warn("❌ Событие взрыва не найдено")
            CreateNotification("❌ Событие взрыва не найдено", 3)
        end
    end
end

