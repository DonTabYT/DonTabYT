local function toggleFly(enable)
    local player = Players.LocalPlayer
    local character = player and player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if enable then
        isFlying = not isFlying
        hrp.Anchored = isFlying
        print("Fly Toggled:", isFlying)
    else
        if isFlying then
            hrp.Anchored = false
            isFlying = false
            print("Fly Disabled")
        end
    end
    updateStatusIndicators()
end

local function setOrUpdateWalkSpeed(speed)
    local player = Players.LocalPlayer
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if defaultWalkSpeed == 16 and humanoid.WalkSpeed ~= 16 then
             defaultWalkSpeed = humanoid.WalkSpeed
             print("Captured default WalkSpeed:", defaultWalkSpeed)
        end
        local success, err = pcall(function() humanoid.WalkSpeed = speed end)
        if success then
            ESPConfig.WalkSpeed = speed
            updateStatusIndicators()
        else
            warn("Failed to set walkspeed:", err)
        end
    else
        warn("Humanoid not found to set WalkSpeed.")
    end
    return humanoid ~= nil
end

local function onInputBegan(input, gameProcessed)
    if gameProcessed or not isScriptRunning then return end

    if input.KeyCode == Enum.KeyCode.V and ESPConfig.EnableFlyBind then
        toggleFly(true)
    end

    if input.KeyCode == Enum.KeyCode.Space and ESPConfig.EnableInfiniteJump then
        local player = Players.LocalPlayer
        local character = player and player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
    end

    if input.KeyCode == Enum.KeyCode.LeftAlt and ESPConfig.EnableClickTP then
        isClickTPActive = true
        print("Click TP: Активирован (удерживайте и кликните)")
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 and isClickTPActive and ESPConfig.EnableClickTP then
         if Mouse and Mouse.Hit then
             local targetPos = Mouse.Hit.Position
             print("Click TP: Телепортация к", targetPos)
             teleportPlayer(targetPos, false)
         else
            warn("Click TP: Не удалось получить позицию клика.")
         end
    end
end

local function onInputEnded(input, gameProcessed)
     if gameProcessed or not isScriptRunning then return end

     if input.KeyCode == Enum.KeyCode.LeftAlt and ESPConfig.EnableClickTP then
        isClickTPActive = false
        print("Click TP: Деактивирован")
     end
end

